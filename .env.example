# ==============================================================================
# Aether Environment Configuration Template (`.env.example`)
# ==============================================================================
# Copy this file to `.env` and adjust paths/URLs for your host or Synology DS1522+.
# Never commit real secrets or pairing tokens to Git.
# ==============================================================================

# Image tag: latest (default from main) or develop (latest develop branch)
# AETHER_TAG=latest

# ------------------------------------------------------------------------------
# 1. Core / Standalone Configuration (`docker-compose.yml`)
# ------------------------------------------------------------------------------
# Public canonical URL seen by the browser.
# - Localhost testing: http://127.0.0.1:3000
# - LAN / Production (behind DSM Reverse Proxy / Caddy / Nginx with TLS): https://media.nas.lan:8443
MEDIA_PUBLIC_URL=http://127.0.0.1:3000

# Host bind address and port for Core container
MEDIA_CORE_BIND_HOST=127.0.0.1
MEDIA_CORE_PORT=3000

# Internal URL used by remote Media Nodes to push scan batches to Core
# In single-host Docker Compose (`compose.distributed.yaml`), use `http://aether-core:3000`
MEDIA_CORE_INTERNAL_URL=http://aether-core:3000

# Standalone mode only (`docker-compose.yml`): read-only host path mounted at `/media:ro`
# On Synology DSM, e.g. `/volume1/video`
MEDIA_LIBRARY_DIR=./tests/fixtures/generated

# ------------------------------------------------------------------------------
# 2. Distributed Media Nodes Configuration (`compose.distributed.yaml`)
# ------------------------------------------------------------------------------
# Host read-only paths for Films and Series libraries.
# On Synology DS1522+, set these to your real shared folders (e.g. `/volume1/video/Films` and `/volume1/video/Series`).
# Aether mounts them strictly `:ro` and never modifies any file or Jellyfin metadata.
MEDIA_FILMS_DIR=./tests/fixtures/generated
MEDIA_SERIES_DIR=./tests/fixtures/generated

# Polyvalent Node (handles both Films and Series libraries)
MEDIA_NODE_NAME=Node Principal
MEDIA_NODE_BIND_HOST=127.0.0.1
MEDIA_NODE_PORT=4101
# Optional browser-reachable URL for direct streaming (`/stream/v1/...`).
# Leave empty if the Node is only reachable via Core internal network (Core will automatically relay in 64 KiB chunks).
MEDIA_NODE_PUBLIC_URL=http://127.0.0.1:4101
# One-time bootstrap token required by administrator during initial pairing (`POST /api/v1/admin/nodes/pair`).
# Generate a random secret before starting: `openssl rand -hex 24` (at least 24 bytes / 48 hex chars)
MEDIA_NODE_PAIRING_TOKEN=

# Optional: Additional independent Node (e.g. Node 2 on second storage machine)
# MEDIA_NODE_2_NAME=Node Secondaire
# MEDIA_NODE_2_PORT=4102
# MEDIA_NODE_2_PUBLIC_URL=http://127.0.0.1:4102
# MEDIA_NODE_2_PAIRING_TOKEN=

# Internal transport: HTTPS with normal certificate/hostname validation by default.
# Comma-separated exact host:port destinations. Never use wildcards or metadata endpoints.
MEDIA_INTERNAL_ALLOWED_AUTHORITIES=
# true only for an isolated, explicitly trusted Docker bridge; never across machines.
MEDIA_INTERNAL_TRUSTED_HTTP=false
# Optional additional PEM CA, mounted read-only into Core and Nodes.
MEDIA_INTERNAL_CA_FILE=

# OIDC Authentik (Core only, standalone and distributed). Local login stays enabled.
MEDIA_OIDC_ENABLED=false
# Exact provider issuer including trailing slash; Authentik per-provider issuer mode.
MEDIA_OIDC_ISSUER=https://auth.example.test/application/o/media/
MEDIA_OIDC_CLIENT_ID=
MEDIA_OIDC_CLIENT_SECRET=
# Exact comma-separated groups granting role user. No automatic administrator mapping.
MEDIA_OIDC_USER_GROUPS=media-users
# Register exactly: ${MEDIA_PUBLIC_URL}/api/v1/auth/oidc/callback
# Details: docs/OIDC.md. Never set these variables on Media Nodes.

  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "media_session"
      }
    },
    "schemas": {
      "Manifest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "id",
          "name",
          "version",
          "description",
          "author",
          "license",
          "repository",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "apiVersion": {
            "type": "integer",
            "const": 1
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "const": "metadata.read"
            }
          }
        }
      },
      "Package": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest",
          "publisherId",
          "wasm",
          "sha256",
          "signature"
        ],
        "properties": {
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          },
          "publisherId": {
            "type": "string"
          },
          "wasm": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        }
      },
      "Configuration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled",
          "libraryIds"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "libraryIds": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Publisher": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "publicKey"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          }
        }
      },
      "Run": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workId"
        ],
        "properties": {
          "workId": {
            "type": "string"
          }
        }
      },
      "Removal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deleteData"
        ],
        "properties": {
          "deleteData": {
            "type": "boolean"
          }
        }
      },
      "Proposal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "summary"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "summary": {
            "type": "string",
            "maxLength": 16384
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Installed": {
        "type": "object",
        "required": [
          "manifest",
          "publisherId",
          "sha256",
          "enabled",
          "libraryIds"
        ],
        "properties": {
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          },
          "publisherId": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "libraryIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PublisherState": {
        "type": "object",
        "required": [
          "id",
          "publicKey",
          "active"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "RunState": {
        "type": "object",
        "required": [
          "id",
          "extensionId",
          "libraryId",
          "workId",
          "status",
          "startedAt",
          "durationMs",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "extensionId": {
            "type": "string"
          },
          "libraryId": {
            "type": "string"
          },
          "workId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "startedAt": {
            "type": "integer"
          },
          "durationMs": {
            "type": "integer"
          },
          "result": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "AuditEntry": {
        "type": "object",
        "required": [
          "actorId",
          "extensionId",
          "action",
          "createdAt"
        ],
        "properties": {
          "actorId": {
            "type": "string"
          },
          "extensionId": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer"
          }
        }
      }
    }
  }

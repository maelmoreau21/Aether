# ==============================================================================
# AETHER — CONFIGURATION COMPLÈTE DE TOUTES LES VARIABLES D'ENVIRONNEMENT
# ==============================================================================
# Ce fichier recense TOUTES les variables d'environnement supportées par Aether.
# Copiez ce fichier sous le nom `.env` et adaptez les valeurs à votre infrastructure.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERSIONNEMENT ET IMAGES DOCKER
# ------------------------------------------------------------------------------
# Tag de l'image Docker à exécuter :
# - `latest`  : version stable issue de la branche main
# - `develop` : dernière version de développement (recommandé pour les dernières nouveautés)
AETHER_TAG=develop

# Surcharge facultative de la version affichée dans l'interface et l'API
# (Laisser vide pour utiliser la version compilée automatiquement, ex: 0.1.0-beta)
MEDIA_VERSION=


# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES (POSTGRESQL 18 OU SQLITE)
# ------------------------------------------------------------------------------
# Moteur de base de données :
# - `postgres` : pour utiliser votre base PostgreSQL 18 externe
# - `sqlite`   : moteur embarqué autonome par défaut
MEDIA_DB_ENGINE=postgres

# URL de connexion à votre serveur PostgreSQL 18 externe :
# Format : postgresql://[UTILISATEUR]:[MOT_DE_PASSE]@[HÔTE_OU_IP]:[PORT]/[NOM_BASE]?sslmode=[MODE]
#
# Exemples :
# - Sans chiffrement SSL sur réseau local sécurisé :
#   MEDIA_DB_URL=postgresql://aether_user:CHANGE_ME_PASSWORD@10.0.0.50:5432/aether_db?sslmode=disable
# - Avec chiffrement SSL vérifié :
#   MEDIA_DB_URL=postgresql://aether_user:CHANGE_ME_PASSWORD@postgres.mondomaine.lan:5432/aether_db?sslmode=verify-full
MEDIA_DB_URL=postgresql://aether_user:CHANGE_ME_PASSWORD@postgres.mondomaine.lan:5432/aether_db?sslmode=disable

# [Spécifique SQLite uniquement] — Fichier de base de données local (ignoré si MEDIA_DB_ENGINE=postgres)
MEDIA_DB_PATH=/data/core.sqlite3

# [Spécifique SQLite uniquement] — Timeout d'attente des verrous SQLite en secondes (défaut : 15)
MEDIA_SQLITE_BUSY_TIMEOUT_SECS=15


# ------------------------------------------------------------------------------
# 3. CORE (SERVEUR PRINCIPAL / API / WEB)
# ------------------------------------------------------------------------------
# Port d'écoute interne du serveur HTTP Core dans son conteneur (défaut : 3000)
MEDIA_PORT=3000

# Adresse IP d'écoute du Core (défaut : 0.0.0.0 pour écouter sur toutes les interfaces du conteneur)
MEDIA_BIND_ADDR=0.0.0.0

# Origine publique canonique accessible par les utilisateurs dans leur navigateur Web.
# RÈGLES DE SÉCURITÉ STRICTES DU PROJET :
# - Pour un test purement local sur la machine hôte : http://127.0.0.1:3000 ou http://localhost:3000
# - Pour TOUT accès réseau LAN / distant / multi-machine : DOIT impérativement être en HTTPS (ex: https://media.mondomaine.fr).
#   Le Core rejette immédiatement au démarrage toute URL HTTP non-loopback (ex: http://192.168.1.x) pour
#   garantir la sécurité des cookies (SameSite=Strict; Secure; HttpOnly) et des jetons de session.
#   Vous devez placer un reverse proxy HTTPS (Nginx, Caddy, Traefik, Synology DSM Reverse Proxy) devant le Core.
MEDIA_PUBLIC_URL=https://aether.mondomaine.lan

# URL interne permettant aux Media Nodes distants de contacter le Core.
# Utilisé pour l'enrôlement sortant, l'ouverture du canal persistant et la remontée des scans.
MEDIA_CORE_INTERNAL_URL=https://aether.mondomaine.lan

# Répertoire du build statique du frontend SvelteKit (déjà configuré par défaut dans l'image Docker)
MEDIA_WEB_DIST=/app/apps/web/build

# [Optionnel en multi-machine] Répertoire multimédia local monté sur la machine du Core
# En mode distribué pur où les médias sont sur des machines séparées (Media Nodes), laissez vide ou non monté.
MEDIA_LIBRARY_ROOT=


# ------------------------------------------------------------------------------
# 4. SÉCURITÉ DES COMMUNICATIONS INTERNES & RÉSEAU (CORE <-> NODES)
# ------------------------------------------------------------------------------
# Liste blanche exacte des autorités autorisées pour les communications réseau internes (séparées par des virgules).
# Exemple : aether.mondomaine.lan:443,node1.mondomaine.lan:443
MEDIA_INTERNAL_ALLOWED_AUTHORITIES=aether.mondomaine.lan:443

# Autoriser HTTP en clair pour les liaisons internes :
# - `false` : (Recommandé) exige HTTPS avec validation des certificats TLS
# - `true`  : UNIQUEMENT acceptable sur un réseau Docker bridge isolé privé sur la même machine
MEDIA_INTERNAL_TRUSTED_HTTP=false

# Chemin vers une autorité de certification (CA) personnalisée au format PEM (.pem / .crt)
# Utile si vous utilisez des certificats TLS auto-signés ou une PKI interne (ex: pfSense, Step-CA, Smallstep).
MEDIA_INTERNAL_CA_FILE=


# ------------------------------------------------------------------------------
# 5. AUTHENTIFICATION SSO OPENID CONNECT (OIDC) — OPTIONNEL
# ------------------------------------------------------------------------------
# Activer le Single Sign-On OIDC (Authentik, Keycloak, Dex, Pocket ID, etc.) : true ou false
MEDIA_OIDC_ENABLED=false

# URL de l'émetteur OIDC (Issuer), obligatoirement en HTTPS (avec slash de fin si requis par votre IdP)
# Exemples :
# - Authentik : https://auth.mondomaine.lan/application/o/aether/
# - Keycloak  : https://auth.mondomaine.lan/realms/mon-realm
MEDIA_OIDC_ISSUER=

# Identifiant client OAuth2 / OIDC
MEDIA_OIDC_CLIENT_ID=

# Secret client OAuth2 / OIDC
MEDIA_OIDC_CLIENT_SECRET=

# Scopes OIDC demandés (défaut : "openid profile email")
MEDIA_OIDC_SCOPES=openid profile email

# Nom du claim de token contenant les groupes / rôles (défaut : "groups", ex: "roles" pour Keycloak)
MEDIA_OIDC_GROUPS_CLAIM=groups

# Exiger la présence d'un groupe pour autoriser la connexion (true ou false)
MEDIA_OIDC_REQUIRE_GROUP=true

# Groupes donnant droit au rôle 'user' dans Aether (séparés par des virgules).
# Note de sécurité : OIDC ne promeut JAMAIS un utilisateur en 'administrator'.
MEDIA_OIDC_USER_GROUPS=aether-users


# ------------------------------------------------------------------------------
# 6. CONFIGURATION D'UN MEDIA NODE (MACHINE DISTANTE DE STOCKAGE)
# ------------------------------------------------------------------------------
# Ces variables sont à définir sur la MACHINE B (serveur de stockage / NAS).

# Port d'écoute interne du Media Node (défaut : 3101)
MEDIA_NODE_PORT=3101

# Adresse d'écoute du Node
MEDIA_NODE_BIND_ADDR=0.0.0.0

# Nom convivial du Media Node affiché dans le panneau d'administration
MEDIA_NODE_NAME=NAS Stockage Films

# Dossiers multimédias autorisés, séparés par ';' ou ':'
# Ces dossiers sont montés STRICTEMENT en lecture seule (:ro). Aether n'y écrit jamais.
MEDIA_NODE_ROOTS=/media/films;/media/series

# Répertoire de données persistantes pour le Node (pour son identité chiffrée node_identity.json)
# DOIT être situé en dehors des répertoires multimédias.
MEDIA_NODE_DATA_DIR=/data

# URL du Core que ce Node doit contacter :
MEDIA_CORE_URL=https://aether.mondomaine.lan

# Jeton d'enrôlement temporaire (Format : mnet_[64_caracteres_hexadécimaux])
# Généré en 1 clic dans l'interface Web (Administration > Media Nodes > "Ajouter un Node").
# Le Node l'utilise une seule fois au démarrage pour dériver un secret mutuel persistant.
MEDIA_NODE_ENROLLMENT_TOKEN=

# URL publique de streaming direct du Node (Optionnel)
# - Si renseignée (ex: https://node1.mondomaine.lan) : le navigateur streamera directement depuis le Node.
# - Si laissée vide : le Node utilise le tunnel sortant NAT-proof vers le Core, qui relaie le flux en mémoire bornée (64 KiB).
#   Aucune ouverture de port ou redirection NAT n'est nécessaire sur la machine du Node !
MEDIA_NODE_PUBLIC_URL=

# Taille des lots lors des scans du catalogue multimédia (défaut : 32, max 128)
MEDIA_NODE_SCAN_BATCH_SIZE=32

# [Méthode d'appairage historique / Legacy] Jeton d'appairage direct (au moins 24 octets hex = 48 caractères)
# Utilisé uniquement si vous n'utilisez pas l'enrôlement automatique mnet_.
MEDIA_NODE_BOOTSTRAP_TOKEN=
MEDIA_NODE_PAIRING_TOKEN=

<?xml version="1.0" encoding="UTF-8"?>
<!-- Aether pour téléviseurs Samsung (Tizen 5.0 et plus). La coquille (shell/) demande l'adresse du Core
     puis ouvre son interface web : toute origine HTTPS doit donc être autorisée. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://github.com/maelmoreau21/Aether/tv" version="1.0.0" viewmodes="maximized">
    <tizen:application id="AetherTV01.Aether" package="AetherTV01" required_version="5.0"/>
    <name>Aether</name>
    <description>Films, séries et musique de votre serveur Aether.</description>
    <author href="https://github.com/maelmoreau21/Aether">Aether</author>
    <license href="https://www.gnu.org/licenses/agpl-3.0.html">AGPL-3.0</license>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>

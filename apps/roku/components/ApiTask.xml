<?xml version="1.0" encoding="utf-8" ?>
<!-- One HTTP call to the Core: set `request`, run, observe `response`. -->
<component name="ApiTask" extends="Task">
  <interface>
    <!-- { server, token, method, path, body (assocarray or invalid), tag } -->
    <field id="request" type="assocarray" />
    <!-- { tag, status, json } ; status 0 = network failure -->
    <field id="response" type="assocarray" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/ApiTask.brs" />
</component>

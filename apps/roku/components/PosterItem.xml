<?xml version="1.0" encoding="utf-8" ?>
<!-- A poster in a RowList. Posters need the device token: fetched through an
     HTTP agent carrying it, sent to the Core only. -->
<component name="PosterItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="showContent" />
    <field id="focusPercent" type="float" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/PosterItem.brs" />
  <children>
    <Rectangle width="240" height="360" color="0x1A1D26FF" />
    <Poster id="poster" width="240" height="360" loadDisplayMode="scaleToZoom" />
    <Label id="title" translation="[0,368]" width="240" height="40" horizAlign="center" font="font:SmallestSystemFont" color="0xF4F6FBFF" />
  </children>
</component>

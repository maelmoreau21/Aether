# ==============================================================================
# Aether Environment Configuration Template (`.env.example`)
# ==============================================================================
# Copy this file to `.env` and adjust paths/URLs for your host or Synology DS1522+.
# Never commit real secrets or pairing tokens to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core / Standalone Configuration
# ------------------------------------------------------------------------------
# Public canonical URL seen by the browser.
# - Localhost testing: http://127.0.0.1:3000
# - LAN / Production (behind DSM Reverse Proxy / Caddy / Nginx with TLS): https://media.nas.lan:8443
MEDIA_PUBLIC_URL=http://127.0.0.1:3000

# Host bind address and port for Core container
MEDIA_CORE_BIND_HOST=127.0.0.1
MEDIA_CORE_PORT=3000

# Internal URL used by remote Media Nodes to push scan batches to Core
# In single-host Docker Compose (`compose.distributed.yaml`), use `http://aether-core:3000`
MEDIA_CORE_INTERNAL_URL=http://aether-core:3000

# Standalone mode only (`compose.yaml`): read-only host path mounted at `/media:ro`
# On Synology DSM, e.g. `/volume1/video`
MEDIA_LIBRARY_DIR=./tests/fixtures/generated

# ------------------------------------------------------------------------------
# 2. Distributed Media Nodes Configuration (`compose.distributed.yaml`)
# ------------------------------------------------------------------------------
# Host read-only paths for Films and Series libraries.
# On Synology DS1522+, set these to your real shared folders (e.g. `/volume1/video/Films` and `/volume1/video/Series`).
# Aether mounts them strictly `:ro` and never modifies any file or Jellyfin metadata.
MEDIA_FILMS_DIR=./tests/fixtures/generated
MEDIA_SERIES_DIR=./tests/fixtures/generated

# Node 1 (Films)
MEDIA_NODE_FILMS_NAME=Node Films
MEDIA_NODE_FILMS_BIND_HOST=127.0.0.1
MEDIA_NODE_FILMS_PORT=4101
# Optional browser-reachable URL for direct streaming (`/stream/v1/...`).
# Leave empty if the Node is only reachable via Core internal network (Core will automatically relay in 64 KiB chunks).
MEDIA_NODE_FILMS_PUBLIC_URL=http://127.0.0.1:4101
# One-time bootstrap token required by administrator during initial pairing (`POST /api/v1/admin/nodes/pair`).
# Generate a random secret before starting: `openssl rand -hex 24`
MEDIA_NODE_FILMS_PAIRING_TOKEN=replace-with-random-hex-token-node-films

# Node 2 (Series)
MEDIA_NODE_SERIES_NAME=Node Séries
MEDIA_NODE_SERIES_BIND_HOST=127.0.0.1
MEDIA_NODE_SERIES_PORT=4102
MEDIA_NODE_SERIES_PUBLIC_URL=http://127.0.0.1:4102
MEDIA_NODE_SERIES_PAIRING_TOKEN=replace-with-random-hex-token-node-series
